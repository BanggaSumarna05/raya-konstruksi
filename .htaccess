# Tolak akses langsung ke file environment dan konfigurasi sensitif,
# tidak bergantung pada keberadaan mod_rewrite.
<FilesMatch "^\.env($|\.)">
    Require all denied
</FilesMatch>

<Files ".htaccess">
    Require all denied
</Files>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forward semua request ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
